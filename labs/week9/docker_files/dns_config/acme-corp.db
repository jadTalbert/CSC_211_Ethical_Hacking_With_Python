$ORIGIN acme-corp.com.
$TTL 3600

@       IN  SOA     ns1.acme-corp.com. hostmaster.acme-corp.com. (
                    2026112201  ; Serial (YYYYMMDDNN)
                    3600        ; Refresh (1 hour)
                    600         ; Retry (10 minutes)
                    86400       ; Expire (24 hours)
                    300         ; Minimum TTL (5 minutes)
)

; --- Name Server & Mail Exchange Records ---
@       IN  NS      ns1.acme-corp.com.
@       IN  MX  10  mail.acme-corp.com.

; --- TXT Records (SPF, Verification & Operational Metadata) ---
@       IN  TXT     "v=spf1 ip4:172.29.0.20 -all"
@       IN  TXT     "acme-site-verification=csc211-capstone-audit-2026"
_dmarc  IN  TXT     "v=DMARC1; p=quarantine; rua=mailto:secops@acme-corp.com"

; --- Apex & Active Container Subnet Mappings (172.29.0.0/24) ---
@           IN  A   172.29.0.30   ; Primary Web Portal (juice-shop)
www         IN  A   172.29.0.30   ; Public Web Alias (juice-shop)
portal      IN  A   172.29.0.30   ; Customer Portal (juice-shop)
dev-api     IN  A   172.29.0.30   ; Pre-Production REST API (juice-shop)
stage       IN  A   172.29.0.20   ; Staging Web & Log Host (forensics-lab)
corp-db     IN  A   172.29.0.20   ; Internal Redis / Data Services (forensics-lab)
mail        IN  A   172.29.0.20   ; Internal Mail / Banner Host (forensics-lab)
recon       IN  A   172.29.0.10   ; Authorized Security Audit Node (student-recon)
ns1         IN  A   172.29.0.53   ; Authoritative Internal DNS (acme-dns)

; --- CNAME Aliases ---
api         IN  CNAME   dev-api.acme-corp.com.
intranet    IN  CNAME   stage.acme-corp.com.